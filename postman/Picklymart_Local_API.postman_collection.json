{
  "info": {
    "name": "Picklymart Local Catalog API",
    "description": "Starter collection for local Picklymart products, categories, brands and media mapping. Requests use a local Sanctum bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "token",
      "value": "PASTE_LOCAL_SANCTUM_TOKEN_HERE"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "mediaAssetId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List/search products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?search=phone&per_page=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "phone"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"LOCAL-001\",\n  \"name\": \"Local Test Product\",\n  \"price\": 2500,\n  \"currency\": \"BDT\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Product details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/products/{{productId}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List root categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories?root=1&per_page=50",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/categories",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Local Test Category\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Category details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Media assets",
      "item": [
        {
          "name": "List media assets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/media-assets?per_page=30",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Attach media to product",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products/{{productId}}/media",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"media_asset_id\": \"{{mediaAssetId}}\",\n  \"role\": \"main\",\n  \"position\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Detach media from product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{productId}}/media/{{mediaAssetId}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        }
      ]
    }
  ]
}